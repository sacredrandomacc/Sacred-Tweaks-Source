<Page x:Class="SacredOverlay.OverlayPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Page.Resources>
  <Style x:Key="RailButton" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="#192234"/><Setter Property="Foreground" Value="#C7D4E7"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Padding" Value="12,9"/></Style>
  <DataTemplate x:Key="MacroRow"><Border Background="#273142" CornerRadius="5" Padding="9" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/><Ellipse Grid.Column="1" Width="8" Height="8" Fill="#7899B8" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border></DataTemplate>
 </Page.Resources>
 <Grid x:Name="Surface" Background="#F0141B29">
  <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F0161D2C" BorderBrush="#27374D" BorderThickness="0,0,1,0" Padding="13">
   <StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,24"><Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="27" Height="27"/><StackPanel><TextBlock Text="SACRED" FontWeight="Bold" FontSize="15" Foreground="#EAF2FF"/><TextBlock Text="OVERLAY" FontSize="9" Foreground="#57AEF5"/></StackPanel></StackPanel>
    <TextBlock Text="MACROS" FontSize="10" Foreground="#718AA8" Margin="4,0,0,11"/>
    <Button Content="✎   Editing" Tag="single_edit" Click="Category_Click" Style="{StaticResource RailButton}"/>
    <Button Content="▣   Building" Tag="auto_build" Click="Category_Click" Style="{StaticResource RailButton}"/>
    <Button Content="ϟ   Movement" Tag="mantle" Click="Category_Click" Style="{StaticResource RailButton}"/>
    <Button Content="⚙   Utility" Tag="pickup" Click="Category_Click" Style="{StaticResource RailButton}"/>
    <Border Height="1" Background="#344253" Margin="0,13,0,20"/>
    <Button Content="☰   All macros" Click="Macros_Click" Style="{StaticResource RailButton}"/>
    <Button Content="⚙   Settings" Click="Settings_Click" Style="{StaticResource RailButton}"/>
    <Button Content="■   Emergency stop" Click="Stop_Click" Style="{StaticResource RailButton}" Background="#543344"/>
    <TextBlock Text="© 2026 Sacred LLC" FontSize="10" Foreground="#73839A" Margin="4,22,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Column="1" Padding="18,15,18,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="MACRO CONTROL" FontWeight="Bold" FontSize="17" Foreground="#EFF5FE"/><TextBlock x:Name="Status" Text="Pair with your desktop app" TextWrapping="Wrap" FontSize="11" Foreground="#9BB2CB"/></StackPanel>
    <Border Grid.Column="1" BorderBrush="#255F91" BorderThickness="1" CornerRadius="5" Background="#172B43" Padding="9,5"><TextBlock Text="SACRED TWEAKS" FontSize="10" Foreground="#66BAFA"/></Border>
   </Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="MacroWorkspace">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
       <TextBlock Text="Choose a macro, then set its binds on the right." FontSize="11" Foreground="#A1B3C8"/>
       <StackPanel Orientation="Horizontal" Spacing="9">
        <Border Background="#202B3A" CornerRadius="7" Width="148" Padding="10"><StackPanel><TextBlock Text="✎  Editing" Foreground="#67B6F3" FontWeight="SemiBold" Margin="0,0,0,9"/><ListView x:Name="EditingCards" ItemTemplate="{StaticResource MacroRow}" IsItemClickEnabled="True" ItemClick="Card_Click" SelectionMode="None" Background="Transparent" BorderThickness="0"/></StackPanel></Border>
        <Border Background="#202B3A" CornerRadius="7" Width="148" Padding="10"><StackPanel><TextBlock Text="▣  Building" Foreground="#67B6F3" FontWeight="SemiBold" Margin="0,0,0,9"/><ListView x:Name="BuildingCards" ItemTemplate="{StaticResource MacroRow}" IsItemClickEnabled="True" ItemClick="Card_Click" SelectionMode="None" Background="Transparent" BorderThickness="0"/></StackPanel></Border>
        <Border Background="#202B3A" CornerRadius="7" Width="148" Padding="10"><StackPanel><TextBlock Text="ϟ  Movement" Foreground="#67B6F3" FontWeight="SemiBold" Margin="0,0,0,9"/><ListView x:Name="MovementCards" ItemTemplate="{StaticResource MacroRow}" IsItemClickEnabled="True" ItemClick="Card_Click" SelectionMode="None" Background="Transparent" BorderThickness="0"/></StackPanel></Border>
        <Border Background="#202B3A" CornerRadius="7" Width="148" Padding="10"><StackPanel><TextBlock Text="⚙  Utility" Foreground="#67B6F3" FontWeight="SemiBold" Margin="0,0,0,9"/><ListView x:Name="UtilityCards" ItemTemplate="{StaticResource MacroRow}" IsItemClickEnabled="True" ItemClick="Card_Click" SelectionMode="None" Background="Transparent" BorderThickness="0"/></StackPanel></Border>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Column="1" Background="#202938" CornerRadius="8" Margin="12,0,0,0" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
       <TextBlock Text="MACRO SETTINGS" FontWeight="Bold" Foreground="#67B6F3" FontSize="13"/>
       <TextBlock x:Name="Description" Text="Select a macro to edit its settings." TextWrapping="Wrap" FontSize="11" Foreground="#BDD0E5"/>
       <StackPanel x:Name="PairPanel" Spacing="7"><TextBlock Text="In desktop Macro studio, choose Pair Game Bar widget." TextWrapping="Wrap" FontSize="11"/><TextBox x:Name="Port" Header="Local port" InputScope="Number" MaxLength="5"/><PasswordBox x:Name="PairCode" Header="Temporary pairing code" MaxLength="100"/><Button Content="Connect" Click="Pair_Click"/></StackPanel>
       <StackPanel x:Name="Fields" Spacing="7"/>
       <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Save" Click="Save_Click"/><Button Content="Enable" Click="Enable_Click"/><Button Content="Disable" Click="Stop_Click"/></StackPanel>
       <TextBlock Text="Gameplay automation is cheating under Epic’s rules. Account bans and tournament disqualification are possible. Detection likelihood is unknown." TextWrapping="Wrap" Foreground="#FFCE95" FontSize="11"/>
       <CheckBox x:Name="RiskAccepted" Content="I understand the cheat and ban risk"/>
       <TextBlock Text="Only one macro can run at a time. Opening Game Bar stops an active macro on focus loss." TextWrapping="Wrap" FontSize="10" Foreground="#A7B7CB"/>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
    <Border x:Name="SettingsPanel" Background="#1B2433" CornerRadius="8" Padding="20" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="13" MaxWidth="600" HorizontalAlignment="Left">
      <Grid Width="560"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⚙  Settings" FontSize="19" FontWeight="Bold"/><Button Grid.Column="1" Content="✕" Click="Macros_Click"/></Grid>
      <TextBlock Text="KEYBINDS  /  APPEARANCE  /  CONNECTION" Foreground="#68B8F7" FontSize="11"/>
      <Border Background="#243044" Height="1"/>
      <ComboBox x:Name="Hotkey" Header="Hide / show the whole widget" SelectedIndex="0" SelectionChanged="Hotkey_Changed"><ComboBoxItem Content="Tab"/><ComboBoxItem Content="F9"/><ComboBoxItem Content="F10"/></ComboBox>
      <TextBlock Text="Tab may also open your Fortnite inventory. F9 and F10 are alternatives. A minimized widget stays running and can be restored with the same key." TextWrapping="Wrap" FontSize="11" Foreground="#A7B7CB"/>
      <Slider x:Name="OpacityControl" Header="Panel opacity" Minimum="40" Maximum="100" Value="94" ValueChanged="Opacity_Changed"/>
      <ComboBox x:Name="Accent" Header="Accent" SelectedIndex="0" SelectionChanged="Accent_Changed"><ComboBoxItem Content="Violet"/><ComboBoxItem Content="Blue"/><ComboBoxItem Content="Gold"/></ComboBox>
      <TextBlock Text="For mouse interaction while pinned, turn OFF Game Bar’s click-through toggle in the Win+G Home Bar. Game input capture may still require Win+G to edit controls." TextWrapping="Wrap" Foreground="#FFCE95" FontSize="11"/>
      <Button Content="Disconnect widget" Click="Disconnect_Click"/>
      <TextBlock Text="Epic does not approve gameplay macros. No overlay mode can guarantee ban safety." TextWrapping="Wrap" FontSize="11" Foreground="#A7B7CB"/>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</Page>
